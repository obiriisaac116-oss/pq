# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL (public — safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key (public — Row-Level Security enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (SECRET — server-side only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Upstash Redis (rate limiting & caching) ──────────────────────────────────
# REST endpoint and token from the Upstash console
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Resend (email) ───────────────────────────────────────────────────────────
# API key from resend.com dashboard (SECRET)
RESEND_API_KEY=re_yourkey

# From address for outbound email — must be a verified domain on Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin email address that receives contact-form notifications
ADMIN_CONTACT_EMAIL=admin@yourdomain.com

# ─── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Site key (public — embedded in the page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key

# Secret key (SECRET — server-side verification only)
TURNSTILE_SECRET_KEY=your-secret-key

# ─── Site metadata ────────────────────────────────────────────────────────────
# Public canonical site URL (used for CORS allow-origin and absolute links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Contact channels (public) ────────────────────────────────────────────────
# WhatsApp number shown on the contact page (international format, no "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=0000000000

# Phone number shown on the contact page
NEXT_PUBLIC_PHONE_NUMBER=0000000000
