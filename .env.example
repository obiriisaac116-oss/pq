# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL (public — safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key (public — Row-Level Security enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service-role key (SECRET — server-side only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Upstash Redis (rate limiting & caching) ──────────────────────────────────
# REST endpoint and token from the Upstash console
UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=you@gmail.com

# 16-character App Password from https://myaccount.google.com/apppasswords
# (NOT your regular Gmail password — 2FA must be enabled first)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin email that receives contact form notifications
ADMIN_CONTACT_EMAIL=you@gmail.com

# ─── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Site key (public — embedded in the page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>

# Secret key (SECRET — server-side verification only)
TURNSTILE_SECRET_KEY=<secret-key>

# ─── Site metadata ────────────────────────────────────────────────────────────
# Public canonical site URL (used for CORS allow-origin and absolute links)
NEXT_PUBLIC_SITE_URL=https://pq-questions26.onrender.com

# ─── Contact channels (public) ────────────────────────────────────────────────
# WhatsApp number shown on the contact page (international format, no "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=+233000000000

# Phone number shown on the contact page
NEXT_PUBLIC_PHONE_NUMBER=+233000000000

# ─── Test credentials (development / CI only — never use real passwords) ──────
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme
